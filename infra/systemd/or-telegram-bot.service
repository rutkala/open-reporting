[Unit]
Description=Open Reporting — Telegram bot (Gemini chat + Claude /queue relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radek
Group=radek
WorkingDirectory=/opt/open-reporting
EnvironmentFile=/opt/open-reporting/.env
ExecStart=/opt/open-reporting/infra/telegram-bot/venv/bin/python /opt/open-reporting/infra/telegram-bot/bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
