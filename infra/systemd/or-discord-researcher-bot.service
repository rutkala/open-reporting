[Unit]
Description=Open Reporting — Discord Researcher bot (sonnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radek
Group=radek
WorkingDirectory=/opt/open-reporting
EnvironmentFile=/opt/open-reporting/.env
Environment=BOT_ROLE=agent
Environment=BOT_NAME=researcher
Environment=AGENT_FILE=/opt/open-reporting/.claude/agents/researcher.md
Environment=CLAUDE_CHAT_MODEL=sonnet
ExecStart=/opt/open-reporting/infra/telegram-bot/venv/bin/python /opt/open-reporting/infra/discord-bot/bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
