# GUS BDL API key (register free at bdl.stat.gov.pl)
BDL_API_KEY=your_key_here

POSTGRES_DB=reporting
POSTGRES_USER=reporting
POSTGRES_PASSWORD=changeme

# Metabase uses a separate DB inside the same Postgres instance
METABASE_DB=metabase

# Your domain (used for MB_SITE_URL and nginx config)
DOMAIN=open-reporting.dev

# Email for Let's Encrypt notifications
CERTBOT_EMAIL=r.utkala@gmail.com

# Ghost Admin API key — copy from Ghost Admin > Integrations > Custom integration
GHOST_KEY_ID=your_ghost_key_id
GHOST_KEY_SECRET=your_ghost_key_secret

# Metabase API key — create under Metabase Admin > Settings > API keys
MB_API_KEY=mb_your_key_here
