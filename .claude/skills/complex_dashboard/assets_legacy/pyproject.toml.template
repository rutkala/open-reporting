# TODO_DOMAIN dashboard — tooling configuration.
#
# Copy to ``products/dashboards/TODO_DOMAIN/pyproject.toml`` and edit
# the ``[project] name`` if you actually publish the dashboard as a
# package. Most dashboards do not — this file exists for ruff / mypy /
# pytest configuration, not for distribution.
#
# Deliberately no ``[build-system]`` section: dashboards are
# applications, not libraries.

[project]
name = "open-reporting-TODO_DOMAIN-dashboard"
version = "0.0.0"
description = "TODO_DOMAIN dashboard for Open Reporting"
requires-python = ">=3.12"

[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
# Default ruleset is intentionally tight; relax per-finding when
# something is wrong-for-your-context.
select = ["E", "F", "I", "B", "UP"]
ignore = []

[tool.ruff.lint.per-file-ignores]
"tests/*" = ["F401"]  # imports may exist solely to register pytest fixtures

[tool.mypy]
python_version = "3.12"
strict_optional = true
warn_unused_ignores = true
ignore_missing_imports = true  # Dash and plotly do not ship complete type stubs

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q --strict-markers"
