#!/usr/bin/env bash
# TODO_DOMAIN dashboard — local dev launcher.
#
# Copy to ``products/dashboards/TODO_DOMAIN/start.sh``, ``chmod +x``,
# replace TODO_DOMAIN, and run ``./start.sh`` from anywhere.
#
# Sets PYTHONPATH so ``import products...`` and ``import
# complex_dashboard...`` resolve, sources .env if present, and runs
# the dashboard with the same Python the systemd unit will use.
set -euo pipefail

PROJECT_ROOT="/opt/open-reporting"
SKILLS_ROOT="${PROJECT_ROOT}/.claude/skills"
DASHBOARD_DIR="${PROJECT_ROOT}/products/dashboards/TODO_DOMAIN"

export PYTHONPATH="${PROJECT_ROOT}:${SKILLS_ROOT}"

# Default warehouse path — override via .env or shell env.
export DUCKDB_PATH="${DUCKDB_PATH:-${PROJECT_ROOT}/data/warehouse.duckdb}"

if [ -f "${DASHBOARD_DIR}/.env" ]; then
    set -o allexport
    # shellcheck disable=SC1091
    source "${DASHBOARD_DIR}/.env"
    set +o allexport
fi

cd "${DASHBOARD_DIR}"
exec python3 app.py
