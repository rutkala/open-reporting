# Open Reporting dashboard — env-var contract.
#
# Copy to ``products/dashboards/<domain>/.env`` and fill in real
# values. The .env file is gitignored — never commit it. Production
# hosts inject the same variables via the systemd unit's
# Environment= / EnvironmentFile= directives instead.
#
# Required vars are read with require_env() (see runtime/log.py) so
# misconfiguration fails at app import, not on the first request.

# ── Required ────────────────────────────────────────────────────────────────

# Path to the DuckDB analytical warehouse.
DUCKDB_PATH=/opt/open-reporting/data/warehouse.duckdb

# ── Optional ────────────────────────────────────────────────────────────────

# Python logging level — DEBUG / INFO / WARNING / ERROR. Default: INFO.
# LOG_LEVEL=INFO

# Sentry DSN for exception tracking. Leave unset to disable Sentry.
# SENTRY_DSN=

# Ghost CMS API key — only dashboards that pull editorial copy.
# GHOST_TOKEN=
