"""TODO_DOMAIN dashboard — overview page render test.

Copy to ``products/dashboards/TODO_DOMAIN/tests/test_page_overview.py``
and strip the ``.template`` suffix. Add one similar file per page.

For multi-page apps, calls the page's ``layout()`` directly and walks
the returned tree for the elements every overview must carry: the
section heading, at least one KPI card, and the headline chart card.
For single-page apps, replace this with a test that walks
``app.layout`` itself.
"""
from dash import html


def test_overview_layout_has_heading():
    from products.dashboards.TODO_DOMAIN.pages import overview

    layout = overview.layout()
    assert isinstance(layout, html.Div)

    headings = _walk(layout, html.H2)
    assert headings, "overview page is missing an H2"
    assert any(getattr(h, "id", None) == "overview" for h in headings), \
        "overview page H2 must have id='overview'"


def _walk(node, kind):
    """Yield every descendant component of the given type (recursive)."""
    found: list = []

    def visit(n):
        if isinstance(n, kind):
            found.append(n)
        children = getattr(n, "children", None)
        if children is None:
            return
        if isinstance(children, list):
            for c in children:
                visit(c)
        else:
            visit(children)

    visit(node)
    return found
