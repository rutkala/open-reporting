"""
TODO_DOMAIN dashboard — data loaders.

Loader pattern reference. Copy this file to
``products/dashboards/TODO_DOMAIN/data_loaders.py`` and replace
the bodies with real warehouse queries.

The report (``app.py``) calls these loaders **once at module load**
and never inside callbacks. Each loader returns a pre-aggregated
``pandas.DataFrame`` (or ``dict`` for scalars) ready to plot — no
``.groupby()``, ``SUM()``, or pivot in ``app.py``.

Column-naming convention (matches ``measures.py``):

- ``dim_<dimension>`` — dimension columns (``dim_year``, ``dim_region``, …)
- ``val_<measure>``   — measure columns (``val_unemployment``, ``val_gdp``, …)

Once these columns are correct, ``MEASURES["unemployment"].to_series(df["val_unemployment"].tolist())``
and ``DIMS["year"].values(df)`` work without any further wiring.

For the loader interface contract see ``specs/data/data_loaders.md``.
For breadth (17 loaders covering every chart family) see
``products/dashboards/template/data.py``.
"""
import pandas as pd

from products.visuals.lib.db import query


# ── Aggregated loaders — one per chart or section ───────────────────────────
def load_by_year() -> pd.DataFrame:
    """Time series — one row per year, one column per measure."""
    return query("""
        SELECT year                AS dim_year,
               AVG(unemployment)   AS val_unemployment,
               AVG(employment)     AS val_employment
        FROM curated.mart_TODO_DOMAIN
        GROUP BY year
        ORDER BY year
    """)


def load_by_region() -> pd.DataFrame:
    """Geographic breakdown — one row per region, one column per measure."""
    return query("""
        SELECT region              AS dim_region,
               AVG(unemployment)   AS val_unemployment,
               AVG(employment)     AS val_employment
        FROM curated.mart_TODO_DOMAIN
        WHERE year = (SELECT MAX(year) FROM curated.mart_TODO_DOMAIN)
        GROUP BY region
        ORDER BY region
    """)


# ── Scalars — single values for KPI cards ──────────────────────────────────
def load_scalars() -> dict:
    """Single-value KPIs. Keys must match ``MEASURES`` keys in ``measures.py``."""
    row = query("""
        SELECT AVG(unemployment) AS val_unemployment,
               AVG(employment)   AS val_employment
        FROM curated.mart_TODO_DOMAIN
        WHERE year = (SELECT MAX(year) FROM curated.mart_TODO_DOMAIN)
    """).iloc[0]
    return {
        "unemployment": float(row["val_unemployment"]),
        "employment":   float(row["val_employment"]),
    }
